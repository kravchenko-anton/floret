PORT=3000

# Optional local Postgres via `npm run docker:up` (compose service `db` only)
POSTGRES_USER=floret
POSTGRES_PASSWORD=floret
POSTGRES_DB=floret
POSTGRES_PORT=5432

# Required. Local compose Postgres, or any hosted Postgres connection string.
# Example local:  postgresql://floret:floret@localhost:5432/floret
# Example hosted: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://floret:floret@localhost:5432/floret

# Hosted Postgres usually needs TLS (default). Set false only for local Docker.
# DATABASE_SSL=false

# Alibaba Cloud Model Studio (OpenAI-compatible)
# https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://ws-bhz61zoeuyveb9s3.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MAX_TOKENS=8192

# Apify (https://console.apify.com/settings/integrations) — required for transcripts
APIFY_TOKEN=
APIFY_ACTOR_ID=pintostudio/youtube-transcript-scraper

# Optional. Sentry error tracking (leave empty to disable).
# SENTRY_DSN=

# Optional. Log level for nestjs-pino (default: debug locally, info in production).
# LOG_LEVEL=info
