PORT=3000

# Optional local Postgres via `npm run docker:up` (compose service `db` only)
POSTGRES_USER=floret
POSTGRES_PASSWORD=floret
POSTGRES_DB=floret
POSTGRES_PORT=5432

# Required. Local compose Postgres, or any hosted Postgres connection string.
# Example local:  postgresql://floret:floret@localhost:5432/floret
# Example hosted: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://floret:floret@localhost:5432/floret

# Hosted Postgres usually needs TLS (default). Set false only for local Docker.
# DATABASE_SSL=false

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Floret

# Optional. Residential HTTP(S) proxy for YouTube transcript fetches.
# Datacenter IPs (Railway, Docker hosts) are often blocked; without a proxy
# blocked requests surface as 503 instead of a false "no transcript" 404.
# Example: http://user:pass@proxy.example.com:8080
# YOUTUBE_PROXY_URL=
