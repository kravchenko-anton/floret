# Local defaults (docker compose). On Railway, leave these unset —
# Railway injects DATABASE_URL when you link a Postgres service.
PORT=3000

POSTGRES_USER=floret
POSTGRES_PASSWORD=floret
POSTGRES_DB=floret
POSTGRES_PORT=5432

# Nest / drizzle on the host talking to Compose Postgres
DATABASE_URL=postgresql://floret:floret@localhost:5432/floret

# Set to false only if a remote DB rejects SSL (local Docker is auto-detected)
# DATABASE_SSL=false

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Floret
